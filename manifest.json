{
  "manifest_version": 3,
  "name": "知到自动助手",
  "version": "1.3.0",
  "description": "智慧树/知到网课自动化：自动连播下一集 + 弹题自动作答（题库优先 → 网页版免费 AI 问答案 → 组合枚举）。",
  "minimum_chrome_version": "102",

  "permissions": ["storage", "tabs", "scripting", "debugger"],

  "host_permissions": [
    "*://*.zhihuishu.com/*",
    "*://gemini.google.com/*",
    "*://gemini.google.co.jp/*",
    "*://gemini.google.co.uk/*",
    "*://gemini.google.com.hk/*",
    "*://gemini.google.com.tw/*",
    "*://*.chat.deepseek.com/*",
    "*://*.deepseek.com/*",
    "*://*.doubao.com/*",
    "*://*.kimi.com/*",
    "*://*.kimi.moonshot.cn/*",
    "*://*.tongyi.com/*",
    "*://*.qianwen.com/*",
    "*://*.tongyi.aliyun.com/*",
    "*://*.yuanbao.tencent.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "action": {
    "default_title": "知到自动助手",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.zhihuishu.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/shared/web-ai.js",
        "src/content/dom.js",
        "src/content/config.js",
        "src/content/bank.js",
        "src/content/video.js",
        "src/content/playlist.js",
        "src/content/quiz.js",
        "src/content/ability.js",
        "src/content/ai-bridge.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://gemini.google.com/*",
        "*://gemini.google.co.jp/*",
        "*://gemini.google.co.uk/*",
        "*://gemini.google.com.hk/*",
        "*://gemini.google.com.tw/*",
        "*://*.chat.deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://*.doubao.com/*",
        "*://*.kimi.com/*",
        "*://*.kimi.moonshot.cn/*",
        "*://*.tongyi.com/*",
        "*://*.qianwen.com/*",
        "*://*.tongyi.aliyun.com/*",
        "*://*.yuanbao.tencent.com/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/shared/web-ai.js",
        "src/content/dom.js",
        "src/content/config.js",
        "src/ai/web-ai.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
